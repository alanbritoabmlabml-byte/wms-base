APP_NAME="Carmen WMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/La_Paz
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

WMS_VERSION=0.2.0

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Base de datos objetivo: MySQL 8 / MariaDB 10.6+ ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wms_base
DB_USERNAME=wms
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

SANCTUM_STATEFUL_DOMAINS=localhost
SANCTUM_TOKEN_PREFIX=

MAIL_MAILER=log

# --- Escritorio web ---
# Usuario y contraseña iniciales los crea el seeder (admin / wms1234).
WMS_COMPANY_NAME="Plásticos Carmen S.R.L."
WMS_LABEL_PRINTER_DEFAULT="Zebra ZD421"
